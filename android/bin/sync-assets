#!/bin/sh
# Copy the Chrome new tab's logic, phrases and font into the app's assets (they are gitignored there).
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
src="$here/../chrome/extension"
cp "$src/lib/voz.js" "$src/data/phrases.json" "$src/fonts/GoogleSans-latin.woff2" "$here/app/src/main/assets/"
