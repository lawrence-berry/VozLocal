#!/bin/sh
# Build the APK in Docker (no Android SDK on the Mac). Default task: assembleDebug.
#   android/bin/build            -> android/app/build/outputs/apk/debug/app-debug.apk
#   android/bin/build clean
# amd64 because the Android build tools (aapt2) only ship for x86_64 Linux; it is emulated on Apple silicon.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
docker build -q --platform linux/amd64 -t vozlocal-android "$here" >/dev/null
[ $# -gt 0 ] || set -- assembleDebug
exec docker run --rm --platform linux/amd64 -u root -e GRADLE_USER_HOME=/gradle-cache \
  -v vozlocal-gradle:/gradle-cache -v "$here/..:/repo" -w /repo/android vozlocal-android gradle --no-daemon "$@"
