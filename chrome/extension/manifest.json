{
  "manifest_version": 3,
  "name": "VozLocal",
  "description": "A Rioplatense Spanish phrase, and then its meaning, in every new tab.",
  "version": "0.1.0",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
