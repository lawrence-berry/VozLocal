#!/bin/sh
# Run a command in the chrome/ Docker image, with the repo mounted at /app. Examples:
#   chrome/bin/dev bin/build-data
#   chrome/bin/dev bundle exec rspec
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
docker build -q -t vozlocal-chrome "$here" >/dev/null
exec docker run --rm -v "$here/..:/app" -w /app/chrome vozlocal-chrome "$@"
