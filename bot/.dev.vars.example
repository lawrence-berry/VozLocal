# Copy to .dev.vars, fill in, and upload with: npx wrangler secret bulk .dev.vars
# Never commit .dev.vars. Keep comments on their own lines: the file is read by
# both zsh (set -a; . ./.dev.vars) and Wrangler. Full walkthrough: SETUP.md.

# Your WhatsApp number, digits only with country code. Comma-separate several.
ALLOWED_NUMBERS=447700900123
# App dashboard > App settings > Basic > App secret.
APP_SECRET=
# Any random string (openssl rand -hex 16). Paste the same into Meta's webhook setup.
VERIFY_TOKEN=
# A permanent system-user token (business.facebook.com > System users > Generate new token).
WHATSAPP_TOKEN=
# App dashboard > Use cases > Customize > Quickstart: the Phone number ID under the From number.
PHONE_NUMBER_ID=
# Any random string (openssl rand -hex 24). The same goes in VOZLOCAL_BOT_TOKEN.
SYNC_TOKEN=
