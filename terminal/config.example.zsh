# VozLocal settings. Copy to config.zsh (gitignored) and uncomment what you need; these are the defaults.
# The plugin reads it on load, so values here win over ones exported in ~/.zshrc. See README.md#settings.
# export VOZLOCAL_REGION=es_AR
# export VOZLOCAL_DELAY=2
# export VOZLOCAL_INTERVAL=30
# export VOZLOCAL_BOT_URL=https://your-bot.example.workers.dev
# export VOZLOCAL_SYNC_INTERVAL=60
# export VOZLOCAL_NOTIFY=1
# VOZLOCAL_BOT_TOKEN is a secret: keep it in ~/.secrets/vozlocal.zsh, outside the repo.
